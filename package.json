{
  "name": "bullseye-theory",
  "private": true,
  "version": "0.1.0",
  "description": "Bullseye Theory educational website and Market Lab",
  "scripts": {
    "validate:market": "node scripts/validate-market-briefs.mjs",
    "validate:site": "node scripts/validate-site-links.mjs",
    "build": "npm run validate:market && npm run validate:site && npm run validate:compliance && npm run validate:course-quizzes && npm run validate:indicator",
    "test": "npm run build && node --test tests/course-runtime.test.mjs",
    "validate:compliance": "node scripts/validate-market-data-guardrails.mjs",
    "start": "node server.mjs",
    "validate:course-quizzes": "node scripts/validate-course-quizzes.mjs",
    "validate:indicator": "node scripts/validate-indicator-entitlement.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

//@version=6
indicator("Bullseye India", "Bullseye India", overlay=true, max_boxes_count=200, max_labels_count=200)

// Core breakout parameters remain fixed to RULES.md.
const int leftBars = 3
const int rightBars = 3
const int atrLength = 14
const float clusterAtr = 0.25
const int minTouches = 2
const float breakoutAtr = 0.10
const int volumeLength = 20
const float volumeMultiple = 1.5
const float stopAtr = 0.20
const float targetRR = 2.0
const int cooldownBars = 12

showZones = input.bool(true, "Show supply/demand zones")
showLabels = input.bool(true, "Show LONG/SHORT labels")
enableAlerts = input.bool(true, "Enable alert() messages")
showContext = input.bool(true, "Show India market context panel")
maxVisibleZones = input.int(18, "Maximum visible zones", minval=4, maxval=40)
maxVisibleLabels = input.int(30, "Maximum visible signal labels", minval=5, maxval=100)
strictConfirmations = input.bool(false, "Require enabled confirmations for signals")
useEmaConfirm = input.bool(false, "EMA 20/50 trend confirmation")
useRsiConfirm = input.bool(false, "RSI 14 momentum confirmation")
useVwapConfirm = input.bool(false, "VWAP confirmation (intraday)")

// Universal chart-symbol logic: NSE shares, indices and futures use their own chart OHLCV.
supportedTf = timeframe.period == "15" or timeframe.period == "60"
atrValue = ta.atr(atrLength)
volumeAverage = ta.sma(volume, volumeLength)
emaFast = ta.ema(close, 20)
emaSlow = ta.ema(close, 50)
rsiValue = ta.rsi(close, 14)
vwapValue = timeframe.isintraday ? ta.vwap(hlc3) : na
volumeAvailable = not na(volume) and volume > 0 and not na(volumeAverage) and volumeAverage > 0
emaBull = emaFast > emaSlow and close > emaFast
emaBear = emaFast < emaSlow and close < emaFast
rsiBull = rsiValue > 50 and rsiValue < 75
rsiBear = rsiValue < 50 and rsiValue > 25
vwapAvailable = not na(vwapValue) and volumeAvailable
vwapBull = vwapAvailable and close > vwapValue
vwapBear = vwapAvailable and close < vwapValue

// Parallel arrays retain seed-anchored clusters and independent cooldowns.
var array<float> seedPrices = array.new_float()
var array<float> seedAtr = array.new_float()
var array<int> zoneTypes = array.new_int()
var array<float> zoneBottoms = array.new_float()
var array<float> zoneTops = array.new_float()
var array<int> zoneTouches = array.new_int()
var array<int> seedBars = array.new_int()
var array<int> lastSignalBars = array.new_int()
var array<box> zoneBoxes = array.new_box()
var array<label> signalLabels = array.new_label()
var array<box> visibleBoxes = array.new_box()

f_addPivot(float price, float pAtr, int pivotBar, int kind) =>
    int bestIndex = -1
    float bestDistance = na
    int count = array.size(seedPrices)
    if count > 0 and not na(pAtr) and pAtr > 0
        for z = 0 to count - 1
            if array.get(zoneTypes, z) == kind
                float distance = math.abs(price - array.get(seedPrices, z))
                float limit = clusterAtr * math.min(pAtr, array.get(seedAtr, z))
                if distance <= limit and (na(bestDistance) or distance < bestDistance)
                    bestIndex := z
                    bestDistance := distance
    if bestIndex == -1
        array.push(seedPrices, price)
        array.push(seedAtr, pAtr)
        array.push(zoneTypes, kind)
        array.push(zoneBottoms, price)
        array.push(zoneTops, price)
        array.push(zoneTouches, 1)
        array.push(seedBars, pivotBar)
        array.push(lastSignalBars, -1000000)
        array.push(zoneBoxes, na)
    else
        float newBottom = math.min(array.get(zoneBottoms, bestIndex), price)
        float newTop = math.max(array.get(zoneTops, bestIndex), price)
        int newTouches = array.get(zoneTouches, bestIndex) + 1
        array.set(zoneBottoms, bestIndex, newBottom)
        array.set(zoneTops, bestIndex, newTop)
        array.set(zoneTouches, bestIndex, newTouches)
        if showZones and newTouches >= minTouches
            box existing = array.get(zoneBoxes, bestIndex)
            color fillColor = kind == 1 ? color.new(color.red, 87) : color.new(color.lime, 87)
            color edgeColor = kind == 1 ? color.new(color.red, 35) : color.new(color.lime, 35)
            if na(existing)
                box created = box.new(left=array.get(seedBars, bestIndex), top=newTop, right=bar_index, bottom=newBottom, xloc=xloc.bar_index, extend=extend.right, bgcolor=fillColor, border_color=edgeColor)
                array.set(zoneBoxes, bestIndex, created)
                array.push(visibleBoxes, created)
                if array.size(visibleBoxes) > maxVisibleZones
                    box oldest = array.shift(visibleBoxes)
                    box.delete(oldest)
            else
                box.set_top(existing, newTop)
                box.set_bottom(existing, newBottom)

// Confirmed pivots only become available after all right-hand candles close.
bool pivotHigh = bar_index >= leftBars + rightBars
bool pivotLow = bar_index >= leftBars + rightBars
if pivotHigh
    float candidateHigh = high[rightBars]
    for j = 0 to rightBars - 1
        if candidateHigh <= high[j]
            pivotHigh := false
    for j = 1 to leftBars
        if candidateHigh <= high[rightBars + j]
            pivotHigh := false
if pivotLow
    float candidateLow = low[rightBars]
    for j = 0 to rightBars - 1
        if candidateLow >= low[j]
            pivotLow := false
    for j = 1 to leftBars
        if candidateLow >= low[rightBars + j]
            pivotLow := false

if barstate.isconfirmed and pivotHigh and not na(atrValue[rightBars]) and atrValue[rightBars] > 0
    f_addPivot(high[rightBars], atrValue[rightBars], bar_index - rightBars, 1)
if barstate.isconfirmed and pivotLow and not na(atrValue[rightBars]) and atrValue[rightBars] > 0
    f_addPivot(low[rightBars], atrValue[rightBars], bar_index - rightBars, -1)

// A selected confirmation is a gate only when strict confirmation mode is enabled.
longContextReady = (not useEmaConfirm or emaBull) and (not useRsiConfirm or rsiBull) and (not useVwapConfirm or vwapBull)
shortContextReady = (not useEmaConfirm or emaBear) and (not useRsiConfirm or rsiBear) and (not useVwapConfirm or vwapBear)
longContextPass = not strictConfirmations or longContextReady
shortContextPass = not strictConfirmations or shortContextReady

// Closed-candle breakouts; at most one signal is emitted per candle.
bool firedOnBar = false
if barstate.isconfirmed and supportedTf and volumeAvailable and not na(atrValue)
    int zoneCount = array.size(seedPrices)
    if zoneCount > 0
        for z = 0 to zoneCount - 1
            int touches = array.get(zoneTouches, z)
            float bottom = array.get(zoneBottoms, z)
            float top = array.get(zoneTops, z)
            int lastSignal = array.get(lastSignalBars, z)
            bool cooldownReady = bar_index - lastSignal >= cooldownBars
            bool volumeReady = volume > volumeAverage * volumeMultiple
            bool longBreak = touches >= minTouches and close > top + breakoutAtr * atrValue and volumeReady and longContextPass
            bool shortBreak = touches >= minTouches and close < bottom - breakoutAtr * atrValue and volumeReady and shortContextPass
            if cooldownReady and not firedOnBar and (longBreak or shortBreak)
                bool isLong = longBreak
                float entryPrice = close
                float stopPrice = isLong ? bottom - stopAtr * atrValue : top + stopAtr * atrValue
                float risk = math.abs(entryPrice - stopPrice)
                if risk > 0
                    float targetPrice = isLong ? entryPrice + risk * targetRR : entryPrice - risk * targetRR
                    string direction = isLong ? "LONG" : "SHORT"
                    string message = "Bullseye India " + direction + " | " + syminfo.tickerid + " | " + timeframe.period + " | Entry: " + str.tostring(entryPrice, format.mintick) + " | SL: " + str.tostring(stopPrice, format.mintick) + " | TP: " + str.tostring(targetPrice, format.mintick) + " | RR: 1:" + str.tostring(targetRR)
                    array.set(lastSignalBars, z, bar_index)
                    firedOnBar := true
                    if showLabels
                        label signalLabel = label.new(bar_index, isLong ? low : high, direction + "\nEntry " + str.tostring(entryPrice, format.mintick) + "\nSL " + str.tostring(stopPrice, format.mintick) + "\nTP " + str.tostring(targetPrice, format.mintick), style=isLong ? label.style_label_up : label.style_label_down, color=isLong ? color.new(color.lime, 0) : color.new(color.red, 0), textcolor=color.black, size=size.small)
                        array.push(signalLabels, signalLabel)
                        if array.size(signalLabels) > maxVisibleLabels
                            label.delete(array.shift(signalLabels))
                    if enableAlerts
                        alert(message, alert.freq_once_per_bar_close)

// Compact context panel; unavailable data is explicitly marked rather than guessed.
var table statusTable = table.new(position.top_right, 2, 7, border_width=1)
if barstate.islast
    if showContext
        table.cell(statusTable, 0, 0, "BULLSEYE INDIA", text_color=color.white, bgcolor=color.new(color.blue, 20))
        table.cell(statusTable, 1, 0, supportedTf ? "CONFIRMED TF" : "UNSUPPORTED TF", text_color=supportedTf ? color.lime : color.orange, bgcolor=color.new(color.black, 10))
        table.cell(statusTable, 0, 1, "Symbol", text_color=color.silver)
        table.cell(statusTable, 1, 1, syminfo.tickerid, text_color=color.white)
        table.cell(statusTable, 0, 2, "Interval", text_color=color.silver)
        table.cell(statusTable, 1, 2, timeframe.period, text_color=supportedTf ? color.lime : color.orange)
        table.cell(statusTable, 0, 3, "Volume", text_color=color.silver)
        table.cell(statusTable, 1, 3, volumeAvailable ? "AVAILABLE" : "N/A · NO SIGNAL", text_color=volumeAvailable ? color.lime : color.orange)
        table.cell(statusTable, 0, 4, "EMA 20/50", text_color=color.silver)
        table.cell(statusTable, 1, 4, na(emaFast) or na(emaSlow) ? "N/A" : emaBull ? "BULLISH" : emaBear ? "BEARISH" : "NEUTRAL", text_color=emaBull ? color.lime : emaBear ? color.red : color.silver)
        table.cell(statusTable, 0, 5, "RSI 14", text_color=color.silver)
        table.cell(statusTable, 1, 5, na(rsiValue) ? "N/A" : str.tostring(rsiValue, "#.0"), text_color=rsiBull ? color.lime : rsiBear ? color.red : color.silver)
        table.cell(statusTable, 0, 6, "VWAP", text_color=color.silver)
        table.cell(statusTable, 1, 6, not vwapAvailable ? "N/A" : vwapBull ? "ABOVE" : vwapBear ? "BELOW" : "AT VWAP", text_color=vwapBull ? color.lime : vwapBear ? color.red : color.silver)
    else
        table.clear(statusTable, 0, 0, 1, 6)
